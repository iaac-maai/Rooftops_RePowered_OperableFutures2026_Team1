{
  "paths": {
    "datasets": "datasets",
    "models": "pipeline/models",
    "reports": "reports"
  },
  "demand_model": {
    "route": "office_energyplus_surrogate",
    "artifact": "pipeline/models/demand_office_energyplus_surrogate.joblib",
    "scope": "One reference office geometry and explicitly simulated operating configurations; expand domain before applying to a selected real building."
  },
  "case_study": {
    "status": "a160_rooftop_screening_complete_provisional",
    "timezone": "Europe/Madrid",
    "host_building_id": "A160",
    "buildings_csv": "datasets/inputs/building_cluster.csv",
    "pv_csv": "datasets/processed/pv_hourly.csv",
    "demand_csv": "datasets/processed/demand_hourly.csv",
    "shares_csv": "datasets/inputs/sharing_coefficients.csv",
    "impact_assumptions_json": "config/impact_assumptions.json"
  },
  "training": {
    "route": "measured_bdg2",
    "building_uses": [
      "Office",
      "Education",
      "Retail"
    ],
    "max_buildings_per_use": 150,
    "minimum_meter_coverage": 0.8,
    "maximum_zero_fraction": 0.8,
    "seed": 42,
    "validation_fraction": 0.2,
    "test_fraction": 0.2,
    "max_training_rows": 600000,
    "n_estimators": 400,
    "max_depth": 5,
    "learning_rate": 0.04,
    "n_jobs": 4,
    "evaluation_years": [
      2016,
      2017
    ],
    "objective": "reg:absoluteerror",
    "area_weighted_loss": true,
    "exclude_from_test_ids_file": "config/experiments/initial_building_ids.json",
    "experiment_label": "expanded_measured_bdg2"
  }
}
